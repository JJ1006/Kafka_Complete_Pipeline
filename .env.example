# Application
APP_ENV=development
APP_SECRET_KEY=your-secret-key-here
APP_API_KEY=your-api-key-here
APP_DEBUG=true

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_TOPIC_TRANSACTIONS=credit.transactions.v1
KAFKA_TOPIC_DLQ=credit.transactions.dlq.v1

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_ALIAS_WRITE=credit-transactions-write
ELASTICSEARCH_INDEX_ALIAS_READ=credit-transactions-read

# Redis
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60

# Auth
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=credit-api

# Rate Limits
RATE_LIMIT_INGEST=500/minute
RATE_LIMIT_QUERY=1000/minute
RATE_LIMIT_DOWNLOAD=10/minute

# Limits
RANGE_MAX_DAYS=90
STREAM_CHUNK_SIZE=1000
